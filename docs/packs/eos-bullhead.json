{
  "schemaVersion": 1,
  "id": "eos-bullhead",
  "name": "/e/OS 4 for Nexus 5X",
  "rom": "/e/OS",
  "romVersion": "4.x (Android 13)",
  "devices": [
    "bullhead"
  ],
  "match": [
    {
      "prop": "ro.elegal.url",
      "matches": "e\\.foundation"
    },
    {
      "prop": "ro.modversion",
      "matches": "^4\\."
    }
  ],
  "profile": {
    "isPhone": true,
    "stockHasNfc": true,
    "stockHasFingerprint": true,
    "stockHasSdSlot": false,
    "stockRearCameraCount": 1,
    "stockFrontCameraCount": 1,
    "stockHasHdr10": false,
    "stockHasExfat": false,
    "stockHasForcedEncryption": true,
    "stockHasHardwareEncryption": true,
    "stockWidthPx": 1080,
    "stockHeightPx": 1920,
    "stockDensityDpi": 420,
    "stockSimSlots": 1,
    "stockHasEsim": false,
    "stockHasVolte": true,
    "stockHasWifiCalling": true,
    "stockHasWakeGestures": false
  },
  "tests": [
    {
      "type": "prop",
      "id": "hardware",
      "title": "Bullhead hardware platform",
      "category": "DEVICE_TREE",
      "level": "MUST",
      "prop": "ro.boot.hardware",
      "equals": "bullhead"
    },
    {
      "type": "guided",
      "id": "led",
      "title": "Notification LED",
      "category": "FEATURES",
      "level": "SHOULD",
      "intro": "Lock the screen and send yourself a message from another device.",
      "steps": [
        {
          "text": "The LED blinks for the new notification.",
          "command": "cat /sys/class/leds/red/brightness /sys/class/leds/green/brightness /sys/class/leds/blue/brightness"
        },
        {
          "text": "The LED charging color shows while plugged in.",
          "shortcut": {
            "label": "Notification settings",
            "action": "android.settings.NOTIFICATION_SETTINGS"
          }
        }
      ]
    }
  ],
  "waivers": [
    {
      "requirement": "sw.kernel.wakegestures",
      "checks": [],
      "reason": "Kept on /e/OS on purpose: the software double-tap-to-wake driver ships off by default and is only turned on by the user."
    },
    {
      "requirement": "sw.playintegrity",
      "checks": [],
      "reason": "Upstream /e/OS behaviour, kept on purpose: frameworks/base SafetyNetHooks reports a Pixel 2 fingerprint to the microG process and blocks hardware key attestation on every /e/OS device. Basic integrity passes with it."
    }
  ],
  "theme": {
    "accentSeed": "#0086FF",
    "cornerScale": 1.5,
    "fontFamily": "sans-serif",
    "icon": "eos"
  }
}
